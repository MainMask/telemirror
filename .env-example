API_ID=test
API_HASH=test
SESSION_STRING=test
USE_MEMORY_DB=true
# (Optional) PostgreSQL connection (use DATABASE_URL or individual params, ignored when USE_MEMORY_DB=true)
# DATABASE_URL=postgres://user:pass@host/dbname
# DB_NAME=telemirror
# DB_USER=postgres
# DB_PASS=secret
# DB_HOST=localhost
CHAT_MAPPING=[-100999999,-100999999,-100999999:-1009999999];
# (Optional) Admin broadcast channel: messages from this channel are sent to ALL configured targets
# BROADCAST_CHANNEL=-100123456789
# (Optional) Whitelist of targets for broadcast channel (comma-separated, use channel#topic for topics).
# When set, broadcast goes only to these channels/topics. When not set, goes to ALL configured targets.
# BROADCAST_TARGETS=-100123456789,-100987654321#5
# (Optional) Technical monitoring channel: receives log alerts (WARNING+) and DM notifications
# TECH_CHANNEL=-100123456789
# (Optional) Delay in seconds between sends for live mirroring directions. Default: 0.5
# SEND_DELAY=0.5
# (Optional) Delay in seconds between sends for broadcast channel sync. Default: 0.5
# BROADCAST_SEND_DELAY=0.5
# (Optional) Logging and health-check server
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000
# (Optional) Env-mode only: filter and mirroring settings (ignored when YAML_CONFIG_ENV or YAML_CONFIG_FILE is set)
# REMOVE_URLS=false
# REMOVE_URLS_WL=example.com,trusted.com
# REMOVE_URLS_LIST=t.me,bit.ly
# DISABLE_EDIT=false
# DISABLE_DELETE=false
# PAST_MODE=last_n=100                   # pick one:
# PAST_MODE=full_history
# PAST_MODE=since_date=2024-01-01T00:00:00
# (Optional) YAML filter configuration thru single-lined env string (new lines (\n) should be replaced to \\n), other filter settings from env will be ignored
YAML_CONFIG_ENV=\n# (Optional) Global filters, will be applied in order\nfilters:\n  - ForwardFormatFilter: # Filter name under telemirror/messagefilters.py\n      # Filters arguments\n      format: "{message_text}\n\nForwarded from [{channel_name}]({message_link})"\n  - EmptyMessageFilter\n  - UrlMessageFilter:\n      blacklist: !!set\n        ? t.me\n  - SkipUrlFilter:\n      skip_mention: false\n\n# (Optional) Global settings\ndisable_edit: true\ndisable_delete: true\nmode: copy # or forward\n\n# (Required) Mirror directions\ndirections:\n  - from: [-1001, -1002, -1003]\n    to: [-100203]\n\n  - from: [-1000#3] # forwards from topic to topic\n    to: [-1001#4]\n\n  - from: [-100226]\n    to: [-1006, -1008]\n    # Overwrite global settings\n    disable_edit: false\n    disable_delete: false\n    mode: forward\n    # Overwrite global filters\n    filters:\n      - UrlMessageFilter:\n          blacklist: !!set\n            ? t.me\n      - KeywordReplaceFilter:\n          keywords:\n            "google.com": "bing.com"       # treat keyword as word\n            "r'google\\.com.*'": "bing.com" # treat keyword as regex expr\n      - SkipWithKeywordsFilter:\n          keywords: !!set\n            ? "stopword"     # treat keyword as word\n            ? "r'badword.*'" # treat keyword as regex expr\n
# The next optional parameters can be set to prevent bans/logouts
# (Optional) System version info for telegram client. You can set it to `4.16.30-vxCUSTOM` or any other value if you believe it will help fix the bans. Default is `platform.uname().release`
# See: https://github.com/LonamiWebs/Telethon/issues/4051
API_SYSTEM_VERSION=
# (Optional) Device model info for telegram client. Default is `platform.uname().machine`
API_DEVICE_MODEL=
# (Optional) Application version info for telegram client. Default is `telethon.version.__version__`
API_APP_VERSION=
