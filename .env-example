API_ID=test
API_HASH=test
SESSION_STRING=test
USE_MEMORY_DB=true
# (Optional) PostgreSQL connection (use DATABASE_URL or individual params, ignored when USE_MEMORY_DB=true)
# DATABASE_URL=postgres://user:pass@host/dbname
# DB_NAME=telemirror
# DB_USER=postgres
# DB_PASS=secret
# DB_HOST=localhost

##############################################################################
# Mirror configuration — pick ONE source (priority: highest first):
#   1. YAML_CONFIG_ENV        (single-line YAML string, below)
#   2. ./.configs/mirror.config.yml  (file; see mirror.config.yml-example)
#   3. CHAT_MAPPING + REMOVE_URLS*/DISABLE_* below (env-only, limited)
# If a higher-priority source is set, the lower ones are ignored.
##############################################################################

# --- Option 3: env-only mirror config ---
CHAT_MAPPING=[-100999999,-100999999,-100999999:-1009999999];
# REMOVE_URLS=false
# REMOVE_URLS_WL=example.com,trusted.com
# REMOVE_URLS_LIST=t.me,bit.ly
# DISABLE_EDIT=false
# DISABLE_DELETE=false
# PAST_MODE=last_n=100                    # or: full_history / since_date=2024-01-01T00:00:00

# --- Option 1: single-line YAML (uncomment to use instead of CHAT_MAPPING) ---
# Structural newlines are written as \n; keep filter string values single-line.
# YAML_CONFIG_ENV=\nfilters:\n  - ForwardFormatFilter:\n      format: "{message_text} — from [{channel_name}]({message_link})"\n  - UrlMessageFilter:\n      blacklist: !!set\n        ? t.me\ndisable_edit: true\ndisable_delete: true\nmode: copy\ndirections:\n  - from: [-1001, -1002]\n    to: [-100203]\n

# (Optional) Admin broadcast channel: messages from this channel are sent to ALL configured targets
# BROADCAST_CHANNEL=-100123456789
# (Optional) Whitelist of targets for broadcast channel (comma-separated, use channel#topic for topics).
# When set, broadcast goes only to these channels/topics. When not set, goes to ALL configured targets.
# BROADCAST_TARGETS=-100123456789,-100987654321#5
# (Optional) Technical monitoring channel: receives log alerts (WARNING+) and DM notifications
# TECH_CHANNEL=-100123456789
# (Optional) Delay in seconds between sends for live mirroring directions. Default: 0.5
# SEND_DELAY=0.5
# (Optional) Delay in seconds between sends for broadcast channel sync. Default: 0.5
# BROADCAST_SEND_DELAY=0.5
# (Optional) Logging and health-check server
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000

# The next optional parameters can be set to prevent bans/logouts.
# Leave commented to use the platform defaults (uname()/telethon version).
# See: https://github.com/LonamiWebs/Telethon/issues/4051
# API_SYSTEM_VERSION=4.16.30-vxCUSTOM
# API_DEVICE_MODEL=Desktop
# API_APP_VERSION=1.0
