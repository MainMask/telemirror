# Session file from `python -m telemirror.login` (recommended). When set, API_ID, API_HASH,
# SESSION_STRING and API_SYSTEM_VERSION/API_DEVICE_MODEL/API_APP_VERSION are
# ignored — the session and the client fingerprint all come from the file.
# SESSION_FILE=sessions/79990000000.jsession
# (Set by systemd's telemirror@<key>.service, not here) run as project <key>:
# session, mirror config and PORT come from projects/<key>/project.yml.
# TELEMIRROR_PROJECT=live
# Otherwise: the raw session string — the file's `auth_key` — plus the app
# credentials it was created with.
API_ID=test
API_HASH=test
SESSION_STRING=test
USE_MEMORY_DB=true
# (Optional) PostgreSQL connection (use DATABASE_URL or individual params, ignored when USE_MEMORY_DB=true)
# DATABASE_URL=postgres://user:pass@host/dbname
# DB_NAME=telemirror
# DB_USER=postgres
# DB_PASS=secret
# DB_HOST=localhost

# Mirror directions and filters live in a YAML file: a project's own (the panel
# edits it), or ./.configs/mirror.config.yml for a run without a project — see
# .configs/mirror.config.yml-example. The channels below may be set there too
# (the YAML wins).

# (Optional) Admin broadcast channel: messages from this channel are sent to ALL configured targets
# as they are (copied; the YAML filters and mode don't apply to them)
# BROADCAST_CHANNEL=-100123456789
# (Optional) Whitelist of targets for broadcast channel (comma-separated, use channel#topic for topics).
# When set, broadcast goes only to these channels/topics. When not set, goes to ALL configured targets.
# BROADCAST_TARGETS=-100123456789,-100987654321#5
# (Optional) Delay in seconds between sends for live mirroring directions. Default: 0.5
# SEND_DELAY=0.5
# (Optional) Delay in seconds between sends for broadcast channel sync. Default: 0.5
# BROADCAST_SEND_DELAY=0.5
# (Optional) Logging and health-check server
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000

# The next optional parameters can be set to prevent bans/logouts.
# Leave commented to use the platform defaults (uname()/telethon version).
# See: https://github.com/LonamiWebs/Telethon/issues/4051
# API_SYSTEM_VERSION=4.16.30-vxCUSTOM
# API_DEVICE_MODEL=Desktop
# API_APP_VERSION=1.0

# (Optional) Telegram control panel bot — python -m bot / telemirror-panel.service.
# Every notice goes to the admins through it: crash alerts (telemirror.alert), a
# mirror's warnings and errors, private messages to its account, a post a replay
# had to skip. Without a token the panel is disabled and there are no notices.
# PANEL_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Telegram user ids allowed to use the panel (comma-separated); required with a token.
# PANEL_ADMIN_IDS=111111111,222222222
