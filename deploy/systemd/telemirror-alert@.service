[Unit]
Description=telemirror — alert that %i entered failed state
# Don't chain into another OnFailure cascade if the alert itself fails.

[Service]
Type=oneshot
WorkingDirectory=/root/telemirror
ExecStart=/root/telemirror/.venv/bin/python -m telemirror.alert %i
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=full
Nice=10
