[Unit]
Description=telemirror — maintenance task of project %i (started by the control panel)
Documentation=https://github.com/MainMask/telemirror
After=network-online.target postgresql.service
Wants=network-online.target
# Uses the project's session — starting a task stops its live mirror; the
# control panel brings it back once the task ends.
Conflicts=telemirror@%i.service
OnFailure=telemirror-alert@%n.service

[Service]
Type=simple
WorkingDirectory=/root/telemirror
Environment=TELEMIRROR_PROJECT=%i
# Written by the panel right before the start: TASK_MODULE (a skylon_set
# module from its whitelist) and TASK_ARGS (flags from its whitelist only).
# No "-" prefix on purpose: without that file (a manual `systemctl start`) the
# unit fails instead of running a script for real with no arguments.
EnvironmentFile=/run/telemirror-panel/%i.env
# $TASK_ARGS unquoted = split on whitespace into separate argv words.
ExecStart=/root/telemirror/.venv/bin/python -u -m skylon_set.${TASK_MODULE} $TASK_ARGS
# No Restart=: a maintenance run is one-shot; the panel shows its result.

MemoryHigh=1100M
MemoryMax=1400M

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
Nice=10

# No [Install] — started only by the panel (systemctl start telemirror-task@<project>).
