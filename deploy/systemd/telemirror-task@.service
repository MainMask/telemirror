[Unit]
Description=telemirror — maintenance task skylon_set.%i (started by the control panel)
Documentation=https://github.com/MainMask/telemirror
After=network-online.target postgresql.service
Wants=network-online.target
# Shares SESSION_STRING with the live mirror — starting a task stops it…
Conflicts=telemirror.service
# …and the mirror comes back whatever the outcome (on failure: also an alert).
OnSuccess=telemirror.service
OnFailure=telemirror-alert@%n.service telemirror.service

[Service]
Type=simple
WorkingDirectory=/root/telemirror
# Written by the panel right before the start, flags from its whitelist only.
# No "-" prefix on purpose: without that file (a manual `systemctl start`) the
# unit fails instead of running the script for real with no arguments.
EnvironmentFile=/run/telemirror-panel/%i.env
# $TASK_ARGS unquoted = split on whitespace into separate argv words.
ExecStart=/root/telemirror/.venv/bin/python -u -m skylon_set.%i $TASK_ARGS
# No Restart=: a maintenance run is one-shot; the panel shows its result.

MemoryHigh=1100M
MemoryMax=1400M

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
Nice=10

# No [Install] — started only by the panel (systemctl start telemirror-task@<module>).
