[Unit]
Description=telemirror — scheduled clean restart of the projects' live mirrors
OnFailure=telemirror-alert@%n.service

[Service]
Type=oneshot
# try-restart: only mirrors that are running — one stopped for a history
# replay, a task or a shared-session pause stays stopped.
ExecStart=/usr/bin/systemctl try-restart telemirror@*.service
