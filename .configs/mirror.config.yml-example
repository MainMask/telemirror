# (Optional) Global filters, will be applied in order
filters:
  - ForwardFormatFilter: # Filter name under telemirror/messagefilters.py
      # Filters arguments
      format: "{message_text}\n\nForwarded from [{channel_name}]({message_link})"
  - EmptyMessageFilter
  - UrlMessageFilter:
      blacklist: !!set
        ? t.me
  - SkipUrlFilter:
      skip_mention: false

# (Optional) Global settings
disable_edit: true
disable_delete: true
mode: copy # or forward

# (Optional) Admin broadcast channel: messages from this channel are sent to ALL configured targets
# broadcast_channel: -100123456789

# (Optional) Technical monitoring channel: receives log alerts (WARNING+) and DM notifications
# tech_channel: -100123456789

# (Required) Mirror directions
directions:
  - from: [-1001, -1002, -1003]
    to: [-100203]

  - from: [-1000#3] # forwards from topic to topic
    to: [-1001#4]

  - from: [-100226]
    to: [-1006, -1008]
    # Overwrite global settings
    disable_edit: false
    disable_delete: false
    mode: forward
    send_delay: 0.0 # override per-direction (0 = no delay)
    # Overwrite global filters
    filters:
      - UrlMessageFilter:
          blacklist: !!set
            ? t.me
      - KeywordReplaceFilter:
          keywords:
            "google.com": "bing.com"       # treat keyword as word
            "r'google\\.com.*'": "bing.com" # treat keyword as regex expr
      - SkipWithKeywordsFilter:
          keywords: !!set
            ? "stopword"     # treat keyword as word
            ? "r'badword.*'" # treat keyword as regex expr