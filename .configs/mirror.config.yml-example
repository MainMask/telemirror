# (Optional) Fallback URL for cross-channel links that cannot be resolved to a mirror
# fallback_link_url: "https://t.me/yourchannel"

# (Optional) Global filters, applied in order. Ordering rule: cheap "skip" filters
# that only read text/entities go FIRST, so a message they drop never pays for the
# work of the transforming / media filters below them.
filters:
  - SkipUrlFilter:
      skip_mention: false
  - UrlMessageFilter:
      blacklist: !!set
        ? t.me
      # whitelist: !!set   # keep these URLs even if they match blacklist
      #   ? example.com
      #   ? t.me/c/        # prefix: preserve private channel message links (internal mirrors)
      # placeholder: "***" # replacement text for removed URLs, default "***"
      # filter_mention: false  # also filter @mentions
  - ForwardFormatFilter: # Filter name from telemirror/messagefilters/
      # Filters arguments
      format: "{message_text}\n\nForwarded from [{channel_name}]({message_link})"

# (Optional) Global settings
disable_edit: true
disable_delete: true
mode: copy # or forward

# (Optional) Admin broadcast channel: messages from this channel are sent to ALL configured targets
# broadcast_channel: -100123456789

# (Optional) Whitelist of targets for broadcast channel. When not set, goes to ALL configured targets.
# broadcast_targets:
#   - -100123456789
#   - -100987654321#5     # topic-specific target

# (Optional) Technical monitoring channel: receives log alerts (WARNING+) and DM notifications
# tech_channel: -100123456789

# (Required) Mirror directions
directions:
  - from: [-1001, -1002, -1003]
    to: [-100203]

  - from: [-1000#3] # forwards from topic to topic
    to: [-1001#4]

  - from: [-100226]
    to: [-1006, -1008]
    # Overwrite global settings
    disable_edit: false
    disable_delete: false
    mode: forward
    send_delay: 0.0 # override per-direction (0 = no delay)
    # (Optional) Sync past messages on startup. Exactly one strategy must be set.
    past_mode:
      last_n: 100       # sync last 100 messages
      send_delay: 1.0   # delay between replayed messages (seconds)
    # past_mode:
    #   full_history: true
    # past_mode:
    #   since_date: "2024-01-01T00:00:00"
    # Overwrite global filters
    filters:
      - SkipWithUrlFilter:      # must come before UrlMessageFilter (runs on raw entities)
          blacklist: !!set      # block messages containing links to these channels
            ? t.me/channel_a
            ? t.me/channel_b
      - SkipWithKeywordsFilter:      # drop early, before the transforming filters below
          keywords: !!set
            ? "stopword"     # treat keyword as word
            ? "r'badword.*'" # treat keyword as regex expr
      - UrlMessageFilter:
          blacklist: !!set
            ? t.me
      - KeywordReplaceFilter:
          keywords:
            "google.com": "bing.com"       # treat keyword as word
            "r'google\\.com.*'": "bing.com" # treat keyword as regex expr
      # - AllowWithKeywordsFilter:   # pass ONLY messages that contain at least one keyword
      #     keywords: !!set
      #       ? "allowed_word"
      # - WatermarkRemovalFilter:      # strip the source's watermark and/or stamp your own (Linux/Docker only)
      #     remove_watermark: true     # detect + inpaint the source's mark (needs template_path)
      #     stamp_watermark: true      # overlay telemirror/watermark/my_watermark.png
      #     template_path: "/data/watermarks/channel_wm.png"
      #     match_threshold: 0.75      # detection sensitivity (0.0–1.0)
      #     # channels: [-1001585626790, -1009876543210]  # optional: limit to these sources
      # - RestrictSavingContentBypassFilter:  # bypass a source chat's "restrict saving content"
      #                                       # (noforwards) protection by re-uploading media as a
      #                                       # fresh file; requires mode: copy. No arguments.
      #                                       # If used together with WatermarkRemovalFilter, must
      #                                       # come after it (it replaces the message's media).
      # - DocumentFilenameFilter:    # rename mirrored document files; requires mode: copy.
      #     suffix: "@MyChannel"     #   appended as "{name} - {suffix}" (skipped if already present)
      #     remove:                  #   substrings stripped from the filename (case-insensitive)
      #       - "@promo"
      #       - "promo"
      #                              # Place after WatermarkRemovalFilter / RestrictSavingContentBypassFilter.
